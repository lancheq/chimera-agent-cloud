+def parse_value(raw):
+    """返回 (value, qualifier, exact)。限值符号保留，不当作精确值。"""
+    if isinstance(raw, (int, float)):
+        return float(raw), None, True
+    if not isinstance(raw, str):
+        return None, None, False
+    s = raw.strip().replace(",", "")
+    m = QUAL.match(s)
+    q = None
+    if m:
+        q = m.group(1)
+        s = s[m.end():]
+    m2 = re.match(r"^(\d+(?:\.\d+)?)", s)
+    if not m2:
+        return None, q, False
+    return float(m2.group(1)), q, (q is None)
 
 
