"""
启动 Qwen3.6-35B-A3B Q4 LLM 服务 (CUDA + flash_attn + KV q8_0)

RTX 4090 (24GB) 显存约束:
  - 模型权重 ~20GB (GPU)
  - KV cache 量化 (q8_0) + flash_attn 以适配剩余 ~3GB 显存
  - 上下文 16384 tokens

OpenAI 兼容 API:
  GET  /v1/models
  POST /v1/chat/completions
"""
import os
import time
import json
from typing import List, Optional
from fastapi import FastAPI, HTTPException, Header
from pydantic import BaseModel
from llama_cpp import Llama
import uvicorn

MODEL_FILE = os.environ.get("MODEL_FILE", "model/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf")
PORT = int(os.environ.get("QWEN_PORT", "8765"))
HOST = os.environ.get("QWEN_HOST", "127.0.0.1")
API_KEY = os.environ.get("LLAMA_API_KEY", "no-key")

print(f"=== 启动 Qwen3.6-35B-A3B Q4 (CUDA + flash_attn + KV q8_0) ===", flush=True)
print(f"模型: {MODEL_FILE}", flush=True)
print(f"端口: {PORT}", flush=True)
print(f"上下文: 16384, KV cache: q8_0, flash_attn: True", flush=True)

# 加载模型
llm = Llama(
    model_path=MODEL_FILE,
    n_gpu_layers=-1,        # 全部层进 GPU
    n_ctx=16384,             # 上下文长度
    n_batch=512,
    type_k=8,                # q8_0 KV cache 量化
    type_v=8,
    flash_attn=True,         # KV 量化必须启用
    verbose=False,
)
print("=== 模型加载完成, 启动 API 服务 ===", flush=True)

app = FastAPI(title="Qwen3.6-35B-A3B Q4 LLM Server")


class ChatMessage(BaseModel):
    role: str
    content: str


class ChatRequest(BaseModel):
    model: str = "qwen"
    messages: List[ChatMessage]
    max_tokens: int = 1024
    temperature: float = 0.7
    top_p: float = 0.9
    stream: bool = False


@app.get("/v1/models")
async def list_models():
    return {
        "object": "list",
        "data": [{
            "id": "qwen",
            "object": "model",
            "owned_by": "me",
            "permissions": [],
        }],
    }


@app.post("/v1/chat/completions")
async def chat_completions(req: ChatRequest, authorization: Optional[str] = Header(None)):
    # API key 校验 (可选)
    if API_KEY != "no-key" and authorization:
        token = authorization.replace("Bearer ", "")
        if token != API_KEY:
            raise HTTPException(status_code=401, detail="Invalid API key")

    messages = [{"role": m.role, "content": m.content} for m in req.messages]

    try:
        resp = llm.create_chat_completion(
            messages=messages,
            max_tokens=req.max_tokens,
            temperature=req.temperature,
            top_p=req.top_p,
            stream=False,
        )
        return resp
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/health")
async def health():
    return {"status": "ok", "model": MODEL_FILE}


if __name__ == "__main__":
    uvicorn.run(app, host=HOST, port=PORT, log_level="info")
